# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

# Genera una clave nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=pega-aqui-la-clave-generada
DJANGO_DEBUG=True

# ".app.github.dev" permite abrir el servidor desde GitHub Codespaces
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.app.github.dev
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.app.github.dev

# Base de datos: si dejas DB_NAME vacío se usa SQLite (recomendado en desarrollo).
# Rellena estas líneas solo si quieres usar MySQL.
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
